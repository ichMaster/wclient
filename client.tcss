Screen {
    background: $surface;
}

#bar {
    height: 3;
    padding: 0 1;
    align: center middle;
}

#bar > Select {
    width: 12;
    margin-right: 1;
}

#bar > Input {
    width: 1fr;
    margin: 0 1;
}

#bar > Button {
    width: 10;
    margin-left: 1;
}

#tabs {
    height: 10;
    border: solid $primary;
    margin: 0 1;
}

#header-input, #body-input {
    height: 100%;
}

#status {
    height: 1;
    padding: 0 2;
    background: $panel;
    text-style: bold;
}

#res-tabs {
    height: 1fr;
    border: solid $secondary;
    margin: 0 1 1 1;
}

#res-body, #res-headers {
    height: 100%;
}
